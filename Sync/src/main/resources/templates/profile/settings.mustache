{{>layouts/header}}
{{#successMsg}}<div style="background:rgba(30,215,96,.1);border:1px solid rgba(30,215,96,.3);border-radius:var(--radius-md);padding:12px 16px;font-size:13px;color:var(--accent);margin-bottom:20px">{{successMsg}}</div>{{/successMsg}}
{{#errorMsg}}<div style="background:rgba(243,114,127,.1);border:1px solid rgba(243,114,127,.3);border-radius:var(--radius-md);padding:12px 16px;font-size:13px;color:var(--negative);margin-bottom:20px">{{errorMsg}}</div>{{/errorMsg}}
{{#loginUser}}
<div class="profile-page">
  <div class="profile-header">
    <div class="profile-avatar" id="profile-avatar-display">{{initials}}</div>
    <div class="profile-header-info">
      <div class="profile-type">프로필</div>
      <div class="profile-name">{{displayName}}</div>
      <div class="profile-meta">@{{username}} · {{email}}</div>
    </div>
  </div>
  <div class="settings-section">
    <div class="settings-title">기본 정보</div>
    <form action="/profile/update" method="post">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">이름</label>
          <input type="text" name="displayName" class="form-input" value="{{displayName}}" placeholder="표시될 이름">
        </div>
        <div class="form-group">
          <label class="form-label">사용자명</label>
          <input type="text" name="username" class="form-input" value="{{username}}" readonly style="opacity:.6;cursor:not-allowed">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">이메일</label>
        <input type="email" name="email" class="form-input" value="{{email}}">
      </div>
      <div class="form-group">
        <label class="form-label">새 비밀번호 (변경 시에만 입력)</label>
        <input type="password" name="password" class="form-input" placeholder="새 비밀번호 (8자 이상)">
      </div>
      <button type="submit" class="pill-btn accent" style="background:var(--accent);color:#000;border:none;padding:9px 22px;border-radius:var(--radius-full);font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font);margin-top:8px">저장</button>
    </form>
  </div>
  <div class="settings-section">
    <div class="settings-title">계정</div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:16px;background:var(--bg-mid);border-radius:var(--radius-lg)">
      <div>
        <div style="font-size:14px;font-weight:700">로그아웃</div>
        <div style="font-size:12px;color:var(--text-secondary);margin-top:2px">현재 {{displayName}} 으로 로그인 중</div>
      </div>
      <a href="/logout" style="background:rgba(255,255,255,.07);color:var(--text-base);border:1px solid rgba(255,255,255,.12);padding:7px 16px;border-radius:var(--radius-full);font-size:13px;font-weight:700;cursor:pointer;text-decoration:none">로그아웃</a>
    </div>
  </div>
</div>
{{/loginUser}}
{{>layouts/footer}}
