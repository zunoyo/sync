{{>layouts/header}}
<div class="sync-page">
  <div class="sync-hero">
    <div class="sync-hero-icon">🤖</div>
    <div class="sync-hero-title">Sync <span style="color:var(--accent)">AI</span></div>
    <div class="sync-hero-subtitle">지금 내 감정과 상황에 딱 맞는 음악을 찾아드려요</div>
  </div>
  <div class="section">
    <div class="section-header"><h2 class="section-title">지금 무드는?</h2></div>
    <div class="sync-moods" id="sync-moods">
      <button class="mood-pill" onclick="this.classList.toggle('active')">😊 기분 좋을 때</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">😢 감성 충전</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">💪 운동할 때</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">🌙 밤에 혼자</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">🚗 드라이브</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">📚 집중할 때</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">🎉 파티 분위기</button>
      <button class="mood-pill" onclick="this.classList.toggle('active')">☕ 여유로운 아침</button>
    </div>
  </div>
  <div class="sync-input-wrap">
    <div class="sync-image-previews" id="sync-image-previews"></div>
    <div class="sync-input-row">
      <textarea class="sync-textarea" id="sync-textarea" rows="3"
                placeholder="지금 어떤 음악이 듣고 싶으세요? 자유롭게 써보세요&#10;예: 비 오는 날 창가에서 듣기 좋은 음악 추천해줘"></textarea>
      <div class="sync-actions">
        <button class="sync-attach-btn icon-btn" id="sync-attach-btn" title="이미지 첨부">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/></svg>
        </button>
        <input type="file" id="sync-file-input" accept="image/*" style="display:none" multiple>
        <button class="sync-send-btn" onclick="SyncPage.sendMessage()" title="전송">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="section" id="sync-results"></div>
</div>
{{>layouts/footer}}
