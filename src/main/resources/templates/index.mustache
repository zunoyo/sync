        <input type="password" id="modal-su-password"
               placeholder="8자 이상, 영문+숫자+특수문자"
               autocomplete="new-password"
               oninput="AuthModal.onPwInput(this)">
        <div class="pw-strength-bar">
          <div class="pw-strength-fill" id="modal-pw-strength"></div>
        </div>
        <div class="auth-field-hint" id="modal-hint-pw"></div>
      </div>

      <div class="auth-field">
        <label for="modal-su-password2">비밀번호 확인</label>
        <input type="password" id="modal-su-password2"
               placeholder="비밀번호를 다시 입력하세요"
               autocomplete="new-password"
               oninput="AuthModal.validatePw2(this)">
        <div class="auth-field-hint" id="modal-hint-pw2"></div>
      </div>

      <div class="auth-checkbox-row">
        <input type="checkbox" id="modal-su-agree">
        <label for="modal-su-agree">
          <a href="#">서비스 이용약관</a> 및
          <a href="#">개인정보 처리방침</a>에 동의합니다.
        </label>
      </div>

      <button class="auth-btn" id="modal-signup-btn"
              onclick="AuthModal.handleSignup()">회원가입</button>

    </div><!-- end modal-signup-view -->

  </div><!-- end auth-modal-card -->
</div><!-- end auth-modal-overlay -->


