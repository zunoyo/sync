<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SoundWave</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;900&display=swap"
        rel="stylesheet">

  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components/sidebar.css">
  <link rel="stylesheet" href="/css/components/topbar.css">
  <link rel="stylesheet" href="/css/components/player.css">
  <link rel="stylesheet" href="/css/components/cards.css">
  <link rel="stylesheet" href="/css/components/playlist-picker.css">
  <link rel="stylesheet" href="/css/components/right-panel.css">
  <link rel="stylesheet" href="/css/pages/home.css">
  <link rel="stylesheet" href="/css/pages/search.css">
  <link rel="stylesheet" href="/css/pages/friends.css">
  <link rel="stylesheet" href="/css/pages/sync.css">
  <link rel="stylesheet" href="/css/pages/playlist.css">
  <link rel="stylesheet" href="/css/pages/profile.css">

  <!-- 인증 모듈 로드 (모달 방식 — 리다이렉트 없음) -->
  <script src="/js/auth.js"></script>
  <link rel="stylesheet" href="/css/pages/auth.css">
  <link rel="stylesheet" href="/css/pages/splash.css">
  <link rel="stylesheet" href="/css/pages/detail.css">
</head>
<body>

<!-- ════════════════════════════════════════════════
     SPLASH SCREEN — 앱 첫 진입 애니메이션
     splash.js 가 2300ms 후 페이드아웃시킵니다.
════════════════════════════════════════════════ -->
<div id="splash-screen">
  <div class="splash-icon">
    <svg viewBox="0 0 32 32" fill="#000" width="40" height="40">
      <path d="M12.5 10.5v11l9-5.5-9-5.5z"/>
    </svg>
  </div>
  <div class="splash-title">SoundWave</div>
  <div class="splash-tagline">Music for everyone</div>
  <div class="splash-dots">
    <div class="splash-dot"></div>
    <div class="splash-dot"></div>
    <div class="splash-dot"></div>
  </div>
</div>

<div class="app-wrapper">
  <div class="app-shell">

    <!-- ① 사이드바 → components/sidebar.js 교체 -->
    <div id="sidebar-root"></div>

    <div class="app-main-area">
      <main class="main">

        <!-- ② 상단바 → components/topbar.js 교체 (로그인 사용자 정보 표시) -->
        <div id="topbar-root"></div>

        <div class="content">


          <!-- ══ PAGE: 홈 ══════════════════════════════ -->
          <div class="page active" id="page-home">
            <div class="tabs">
              <button class="tab-btn active">전체</button>
              <button class="tab-btn">음악</button>
              <button class="tab-btn">팟캐스트</button>
            </div>
            <div class="quick-grid">
              <div class="quick-item" onclick="DetailPage.showPlaylist(1)"><div class="quick-art" style="background:linear-gradient(135deg,#450af5,#c4efd9)">💚</div><span class="quick-name">좋아요 표시한 곡</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
              <div class="quick-item" onclick="DetailPage.showPlaylist(5)"><div class="quick-art grad-4">🎤</div><span class="quick-name">K-Pop 히트곡</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
              <div class="quick-item" onclick="DetailPage.showPlaylist(4)"><div class="quick-art grad-2">🌊</div><span class="quick-name">Lo-Fi Beats</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
              <div class="quick-item" onclick="DetailPage.showPlaylist(3)"><div class="quick-art grad-3">🚗</div><span class="quick-name">드라이브 플레이리스트</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
              <div class="quick-item" onclick="SearchPage.showGenre('힙합 &amp; R&amp;B','🎧','grad-6')"><div class="quick-art grad-6">🎧</div><span class="quick-name">힙합 &amp; R&amp;B</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
              <div class="quick-item" onclick="DetailPage.showPlaylist(2)"><div class="quick-art grad-1">🎸</div><span class="quick-name">인디 Mix</span><button class="quick-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div>
            </div>
            <div class="hero-banner">
              <div class="hero-art">🎵</div>
              <div class="hero-info">
                <div class="hero-type">추천 플레이리스트</div>
                <div class="hero-title">오늘의<br>신곡 레이더</div>
                <div class="hero-meta"><span>SoundWave</span> 팀 선정 · 3시간 21분</div>
                <div class="hero-actions">
                  <button class="play-btn-large" onclick="togglePlay()"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
                  <button class="action-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button>
                  <button class="action-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg></button>
                </div>
              </div>
            </div>
            <div class="section">
              <div class="section-header"><h2 class="section-title">오늘의 추천</h2><button class="section-more">모두 보기</button></div>
              <div class="cards-grid" id="home-new-releases">
                <div class="card" onclick="SearchPage.showGenre('K-Pop 히트곡 모음','🎤','grad-4')"><div class="card-art"><div class="card-art-inner grad-4">🎤</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">K-Pop 히트곡 모음</div><div class="card-subtitle">aespa, BTS, BLACKPINK 등의 최신 히트곡</div></div>
                <div class="card" onclick="SearchPage.showGenre('Lo-Fi Beats','🌙','grad-2')"><div class="card-art"><div class="card-art-inner grad-2">🌙</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">Lo-Fi Beats</div><div class="card-subtitle">공부하거나 집중할 때</div></div>
                <div class="card" onclick="SearchPage.showGenre('인디 믹스','🎸','grad-1')"><div class="card-art"><div class="card-art-inner grad-1">🎸</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">인디 믹스</div><div class="card-subtitle">국내외 인디 아티스트 큐레이션</div></div>
                <div class="card" onclick="SearchPage.showGenre('힙합 &amp; R&amp;B','🎧','grad-5')"><div class="card-art"><div class="card-art-inner grad-5">🎧</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">힙합 &amp; R&amp;B</div><div class="card-subtitle">지금 가장 핫한 힙합과 R&amp;B</div></div>
                <div class="card" onclick="SearchPage.showGenre('드라이브 플레이리스트','🚗','grad-3')"><div class="card-art"><div class="card-art-inner grad-3">🚗</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">드라이브 플레이리스트</div><div class="card-subtitle">달리는 밤을 위한 완벽한 선곡</div></div>
                <div class="card" onclick="SearchPage.showGenre('클래식 집중','🎻','grad-6')"><div class="card-art"><div class="card-art-inner grad-6">🎻</div><button class="card-play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><div class="card-title">클래식 집중</div><div class="card-subtitle">깊은 집중을 위한 클래식 선곡</div></div>
              </div>
            </div>
            <div class="section">
              <div class="section-header"><h2 class="section-title">인기 아티스트</h2><button class="section-more">모두 보기</button></div>
              <div class="cards-grid artist-grid"></div>
            </div>
            <div class="section">
              <div class="section-header"><h2 class="section-title">🔥 인기 차트 TOP 10</h2><button class="section-more">전체 차트</button></div>
              <div class="track-list" id="track-list"></div>
            </div>
          </div><!-- /page-home -->


          <!-- ══ PAGE: 검색 ══ -->
          <div class="page" id="page-search">
            <div id="search-results-area" style="display:none;padding:0 0 24px"></div>
            <div id="search-browse">
            <h2 class="section-title" style="margin-bottom:24px">모두 둘러보기</h2>
            <div class="genre-grid">
              <div class="genre-chip grad-4" onclick="SearchPage.showGenre('K-Pop','🎤','grad-4')"><span class="genre-chip-label">K-Pop</span><span class="genre-chip-emoji">🎤</span></div>
              <div class="genre-chip grad-6" onclick="SearchPage.showGenre('힙합','🎧','grad-6')"><span class="genre-chip-label">힙합</span><span class="genre-chip-emoji">🎧</span></div>
              <div class="genre-chip grad-1" onclick="SearchPage.showGenre('인디','🎸','grad-1')"><span class="genre-chip-label">인디</span><span class="genre-chip-emoji">🎸</span></div>
              <div class="genre-chip grad-3" onclick="SearchPage.showGenre('R&amp;B','🎵','grad-3')"><span class="genre-chip-label">R&amp;B</span><span class="genre-chip-emoji">🎵</span></div>
              <div class="genre-chip grad-5" onclick="SearchPage.showGenre('팝','⭐','grad-5')"><span class="genre-chip-label">팝</span><span class="genre-chip-emoji">⭐</span></div>
              <div class="genre-chip grad-2" onclick="SearchPage.showGenre('Lo-Fi','🌙','grad-2')"><span class="genre-chip-label">Lo-Fi</span><span class="genre-chip-emoji">🌙</span></div>
              <div class="genre-chip grad-7" onclick="SearchPage.showGenre('클래식','🎻','grad-7')"><span class="genre-chip-label">클래식</span><span class="genre-chip-emoji">🎻</span></div>
              <div class="genre-chip grad-8" onclick="SearchPage.showGenre('재즈','🎺','grad-8')"><span class="genre-chip-label">재즈</span><span class="genre-chip-emoji">🎺</span></div>
              <div class="genre-chip" style="background:linear-gradient(135deg,#ff9a9e,#fecfef)" onclick="SearchPage.showGenre('발라드','💔','grad-7')"><span class="genre-chip-label">발라드</span><span class="genre-chip-emoji">💔</span></div>
              <div class="genre-chip" style="background:linear-gradient(135deg,#a1c4fd,#c2e9fb)" onclick="SearchPage.showGenre('전자음악','🎛️','grad-2')"><span class="genre-chip-label">전자음악</span><span class="genre-chip-emoji">🎛️</span></div>
              <div class="genre-chip" style="background:linear-gradient(135deg,#fddb92,#d1fdff)" onclick="SearchPage.showGenre('어쿠스틱','🪗','grad-1')"><span class="genre-chip-label" style="color:#333">어쿠스틱</span><span class="genre-chip-emoji">🪗</span></div>
              <div class="genre-chip" style="background:linear-gradient(135deg,#e0c3fc,#8ec5fc)" onclick="SearchPage.showGenre('트로트','🌺','grad-7')"><span class="genre-chip-label">트로트</span><span class="genre-chip-emoji">🌺</span></div>
            </div>
            </div><!-- /search-browse -->
          </div><!-- /page-search -->


          <!-- ══ PAGE: 친구 ══════════════════════════════════
               FriendsPage.render() → js/friends.js 처리
          ═══════════════════════════════════════════════ -->
          <div class="page" id="page-friends">

            <div class="friends-header">
              <div>
                <div class="friends-title">친구</div>
                <div class="friends-subtitle">친구 목록을 클릭해 공유 플레이리스트를 확인하세요</div>
              </div>
              <div class="friends-header-actions">
                <button class="frm-open-btn" onclick="FriendRequestsModal.show()">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5
                             c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5
                             s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                  </svg>
                  친구 요청
                  <span class="frm-open-btn-badge" id="frm-open-btn-badge">2</span>
                </button>
                <button class="pill-btn accent" onclick="AddFriendModal.show()">
                  + 친구 추가
                </button>
                <div class="friend-search">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5
                             0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99
                             L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5
                             5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                  </svg>
                  <input type="text" placeholder="친구 검색...">
                </div>
              </div>
            </div>

            <div class="section">
              <div class="friends-section-label">
                <span class="online-indicator"></span>
                <span id="online-count">온라인</span>
              </div>
              <div class="friends-grid" id="friends-online-grid"></div>
            </div>

            <div class="section">
              <div class="friends-section-label">오프라인</div>
              <div class="friends-grid" id="friends-offline-grid"></div>
            </div>

          </div><!-- /page-friends -->


          <!-- ══ PAGE: Sync AI ══ -->
          <div class="page" id="page-sync">
            <div class="sync-hero">
              <span class="sync-logo">🎵</span>
              <div class="sync-title">Sync AI</div>
              <div class="sync-subtitle">지금 기분, 상황, 활동을 알려주세요.<br>AI가 당신만을 위한 완벽한 음악을 추천해드립니다.</div>
              <div class="sync-input-area">
                <textarea id="sync-textarea" placeholder="예: '비 오는 날 카페에서 공부할 때 듣기 좋은 음악'&#10;Ctrl+Enter 로 전송"></textarea>
                <button class="sync-attach-btn" id="sync-attach-btn" title="이미지 첨부"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg></button>
                <input type="file" id="sync-file-input" accept="image/*" multiple>
                <button class="sync-send-btn" onclick="syncSend()" title="전송"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg></button>
              </div>
              <div class="sync-image-previews" id="sync-image-previews"></div>
              <div class="sync-mood-pills" id="sync-moods"></div>
            </div>
            <div class="section"><div class="section-header"><h2 class="section-title" style="font-size:18px">✨ 추천 결과</h2></div><div id="sync-results"></div></div>
            <div class="section">
              <div class="section-header"><h2 class="section-title" style="font-size:18px">📊 내 청취 패턴 분석</h2></div>
              <div style="background:var(--bg-mid);border-radius:var(--radius-lg);padding:20px">
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px">
                  <div style="background:rgba(30,215,96,.1);border:1px solid rgba(30,215,96,.2);border-radius:var(--radius-lg);padding:16px;text-align:center"><div style="font-size:20px;font-weight:900;color:var(--accent)">K-Pop</div><div style="font-size:12px;color:var(--text-secondary);margin-top:4px">가장 많이 들음</div><div style="font-size:24px;font-weight:900;margin-top:8px">68%</div></div>
                  <div style="background:rgba(83,157,245,.1);border:1px solid rgba(83,157,245,.2);border-radius:var(--radius-lg);padding:16px;text-align:center"><div style="font-size:20px;font-weight:900;color:var(--info)">Lo-Fi</div><div style="font-size:12px;color:var(--text-secondary);margin-top:4px">집중할 때</div><div style="font-size:24px;font-weight:900;margin-top:8px">18%</div></div>
                  <div style="background:rgba(255,164,43,.1);border:1px solid rgba(255,164,43,.2);border-radius:var(--radius-lg);padding:16px;text-align:center"><div style="font-size:20px;font-weight:900;color:var(--warning)">인디</div><div style="font-size:12px;color:var(--text-secondary);margin-top:4px">감성 충전</div><div style="font-size:24px;font-weight:900;margin-top:8px">14%</div></div>
                </div>
              </div>
            </div>
          </div><!-- /page-sync -->


          <!-- ══ PAGE: 플레이리스트 ══ -->
          <div class="page" id="page-playlist">
            <div class="section-header" style="margin-bottom:24px"><h2 class="section-title">플레이리스트 관리</h2><button class="pill-btn accent" onclick="CreatePlaylistModal.show()">+ 새 플레이리스트</button></div>
            <div class="playlist-toolbar">
              <div style="position:relative;flex:1;max-width:280px"><svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-secondary);pointer-events:none" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg><input type="text" placeholder="플레이리스트 검색..." style="width:100%;background:var(--bg-card);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-full);padding:9px 16px 9px 36px;font-size:13px;color:var(--text-base);font-family:var(--font);outline:none"></div>
              <div style="display:flex;gap:4px;flex-wrap:wrap">
                <button class="filter-pill pl-filter-btn active" data-filter="all"    onclick="PlaylistPage.render('all')">전체</button>
                <button class="filter-pill pl-filter-btn"        data-filter="my"     onclick="PlaylistPage.render('my')">내 플레이리스트</button>
                <button class="filter-pill pl-filter-btn"        data-filter="saved"  onclick="PlaylistPage.render('saved')">저장된 플레이리스트</button>
                <button class="filter-pill pl-filter-btn"        data-filter="artist" onclick="PlaylistPage.render('artist')">아티스트</button>
                <button class="filter-pill pl-filter-btn"        data-filter="album"  onclick="PlaylistPage.render('album')">앨범</button>
              </div>
            </div>
            <div class="cards-grid" id="playlist-grid"></div>
          </div><!-- /page-playlist -->


          <!-- ══ PAGE: 회원정보 ══════════════════════════
               ⚠ profile-avatar-display ID 추가 (ProfilePage.populate() 타겟)
          ═══════════════════════════════════════════════ -->
          <div class="page" id="page-profile">
            <div class="profile-hero">
              <div class="profile-avatar-wrap">
                <!-- id="profile-avatar-display" : Auth 데이터로 동적 업데이트 -->
                <div class="profile-avatar" id="profile-avatar-display">SW</div>
                <div class="profile-avatar-edit"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></div>
