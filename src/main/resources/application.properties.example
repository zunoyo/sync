spring.application.name=Sync
server.port=8081

# UTF-8 인코딩
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true

# MySQL 데이터베이스
spring.datasource.url=jdbc:mysql://localhost:3306/sync_database
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Mustache 템플릿
spring.mustache.suffix=.mustache
spring.mustache.prefix=classpath:/templates/
spring.mustache.charset=UTF-8

# Python CLIP AI 서버 주소
clip.server.url=http://localhost:8000
ai.service.url=http://localhost:8000

# OAuth 2.0 — Google
google.client.id=YOUR_GOOGLE_CLIENT_ID
google.client.secret=YOUR_GOOGLE_CLIENT_SECRET
google.redirect.uri=http://localhost:8081/api/oauth/google/callback

# OAuth 2.0 — Naver
naver.client.id=YOUR_NAVER_CLIENT_ID
naver.client.secret=YOUR_NAVER_CLIENT_SECRET
naver.redirect.uri=http://localhost:8081/login/oauth2/code/naver

# OAuth 2.0 — Kakao
kakao.client.id=YOUR_KAKAO_CLIENT_ID
kakao.client.secret=YOUR_KAKAO_CLIENT_SECRET
kakao.redirect.uri=http://localhost:8081/login/oauth2/code/kakao

# Spotify API
spotify.client.id=YOUR_SPOTIFY_CLIENT_ID
spotify.client.secret=YOUR_SPOTIFY_CLIENT_SECRET
spotify.redirect.uri=http://localhost:8081/callback

# Last.fm API
lastfm.api.key=YOUR_LASTFM_API_KEY
lastfm.secret=YOUR_LASTFM_SECRET

# JWT 설정
jwt.secret=YOUR_JWT_SECRET_KEY_MIN_32_CHARS
jwt.expiration=86400000
